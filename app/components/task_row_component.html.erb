<article class="<%= root_class %>">
  <%= button_to check_url, method: :patch, class: check_class, form_class: "check-form", title: check_label, aria: { label: check_label } do %>
    <% if @task.dropped? %>
      <span class="check__dropped" aria-hidden="true"><%= icon "square-off" %></span>
    <% elsif @task.done? %>
      <span class="check__complete" aria-hidden="true"><%= icon "square-check-big" %></span>
    <% else %>
      <span class="check__idle" aria-hidden="true"><%= icon "square" %></span>
      <span class="check__hint" aria-hidden="true"><%= icon "square-check-big" %></span>
    <% end %>
  <% end %>

  <div class="body">
    <h2 class="title"><%= @task.title %></h2>
    <% if show_project? %>
      <p class="project">
        <%= link_to @task.project.title, @task.project %>
      </p>
    <% end %>
    <% if @task.notes.present? %>
      <div class="notes"><%= formatted_notes(@task.notes) %></div>
    <% end %>
  </div>

  <div class="actions">
    <% if @context == :inbox && @task.to_do? %>
      <%= button_to "Move to open tasks", move_to_open_task_path(@task), method: :patch, class: btn(:primary) %>
    <% end %>

    <% if @task.to_do? %>
      <%= button_to "Drop", drop_task_path(@task), method: :patch, class: btn(:ghost) %>
    <% else %>
      <span class="state"><%= @task.state.humanize %></span>
      <%= button_to "Reopen", reopen_task_path(@task), method: :patch, class: btn(:ghost) %>
    <% end %>
  </div>
</article>

<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Marskal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Marskal">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png" sizes="512x512">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="app" data-controller="sidebar inspector" data-action="click->sidebar#closeOnNavigate">
        <header class="app-header">
          <button type="button"
                  class="app-header__menu"
                  data-action="sidebar#toggle"
                  data-sidebar-target="menuButton"
                  aria-controls="app-sidebar"
                  aria-expanded="false">
            <%= icon "menu" %>
            <span>Menu</span>
          </button>
          <div class="app-header__brand">
            <%= link_to root_path do %>
              <%= image_tag "/icon.svg", alt: "", class: "app-header__logo" %>
              <span>Marskal</span>
            <% end %>
          </div>
          <div class="app-header__user">
            <span class="app-header__email"><%= Current.user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: btn(:ghost) %>
          </div>
        </header>

        <div class="app-shell">
          <%= render "sidebar" %>

          <main class="app-main">
            <%= render FlashComponent.new(notice: flash[:notice], alert: flash[:alert]) %>
            <%= yield %>
          </main>

          <% if show_task_inspector? %>
            <div class="app-inspector__backdrop" data-action="click->inspector#close"></div>
            <aside id="task-inspector-pane"
                   class="app-inspector"
                   data-inspector-target="panel"
                   tabindex="-1"
                   aria-label="Task inspector">
              <div class="app-inspector__chrome">
                <h2 class="app-inspector__title">Inspector</h2>
                <button type="button"
                        class="app-inspector__close"
                        data-action="inspector#close"
                        aria-label="Close inspector">
                  <%= icon "x" %>
                </button>
              </div>

              <template data-inspector-target="empty">
                <div class="app-inspector__empty">
                  <p>Select a task to edit its details.</p>
                </div>
              </template>

              <%= turbo_frame_tag "task_inspector", **{ src: inspector_frame_src }.compact do %>
                <div class="app-inspector__empty">
                  <p>Select a task to edit its details.</p>
                </div>
              <% end %>
            </aside>
          <% end %>
        </div>
      </div>
    <% else %>
      <main class="app-main app-main--narrow">
        <%= render FlashComponent.new(notice: flash[:notice], alert: flash[:alert]) %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>

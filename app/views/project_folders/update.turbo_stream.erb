<%= turbo_stream.update "inspector" do %>
  <%= render "inspector" %>
<% end %>

<% unless @folder.errors.any? %>
  <%= turbo_stream.update "page-heading", @folder.name if @list_context.blank? %>

  <% if inspector_row_visible? %>
    <%= turbo_stream.replace @folder do %>
      <%= render "project_folders/row", folder: @folder, selected: true, list_context: @list_context %>
    <% end %>
  <% else %>
    <%= turbo_stream.remove @folder %>
  <% end %>
<% end %>

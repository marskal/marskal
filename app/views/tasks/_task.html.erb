<article class="task">
  <div class="task__body">
    <h2 class="task__title"><%= task.title %></h2>
    <% if task.notes.present? %>
      <p class="task__notes"><%= simple_format(task.notes) %></p>
    <% end %>
  </div>

  <div class="task__actions">
    <% if context == :inbox && task.to_do? %>
      <%= button_to "Move to open tasks", move_to_open_task_path(task), method: :patch, class: "btn btn--primary" %>
    <% end %>

    <% if task.to_do? %>
      <%= button_to "Done", complete_task_path(task), method: :patch, class: "btn" %>
      <%= button_to "Drop", drop_task_path(task), method: :patch, class: "btn btn--ghost" %>
    <% else %>
      <span class="task__state"><%= task.state.humanize %></span>
      <%= button_to "Reopen", reopen_task_path(task), method: :patch, class: "btn btn--ghost" %>
    <% end %>
  </div>
</article>

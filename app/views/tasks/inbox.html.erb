<% content_for :title, "Inbox — Marskal" %>

<section class="page">
  <header class="page__header">
    <h1>Inbox</h1>
    <p class="page__lede">New tasks land here. Move them to open tasks when you’re ready to act on them.</p>
  </header>

  <%= render "tasks/add_form" %>

  <% if @tasks.any? %>
    <ul class="task-list">
      <% @tasks.each do |task| %>
        <li class="task-list__item" id="<%= dom_id(task) %>">
          <%= render "tasks/task", task: task, context: :inbox %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">Inbox is empty. Add a task above.</p>
  <% end %>
</section>

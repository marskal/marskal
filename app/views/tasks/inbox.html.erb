<% content_for :title, "Inbox — Marskal" %>

<section class="page">
  <header class="page__header">
    <h1>Inbox</h1>
    <p class="page__lede">New tasks land here. Move them to open tasks when you’re ready to act on them.</p>
  </header>

  <%= render "tasks/add_form" %>

  <% if @tasks.any? %>
    <%= render "tasks/list", tasks: @tasks, context: :inbox %>
  <% else %>
    <%= render EmptyStateComponent.new do %>
      Inbox is empty. Add a task above.
    <% end %>
  <% end %>
</section>

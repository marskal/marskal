<%= form_with model: Task.new, url: tasks_path, class: "add-form" do |form| %>
  <div class="add-form__row">
    <%= form.text_field :title,
          required: true,
          autofocus: true,
          placeholder: "Add a task…",
          class: "add-form__title",
          autocomplete: "off" %>
    <%= form.submit "Add", class: btn(:primary) %>
  </div>
  <details class="add-form__notes">
    <summary>Notes (optional)</summary>
    <%= form.text_area :notes, rows: 3, placeholder: "Extra detail…", class: "add-form__notes-field" %>
  </details>
<% end %>

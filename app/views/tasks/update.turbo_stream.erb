<%= turbo_stream.update "task_inspector" do %>
  <%= render "inspector" %>
<% end %>

<% unless @task.errors.any? %>
  <% if inspector_row_visible? %>
    <%= turbo_stream.replace @task do %>
      <%= render "tasks/item", task: @task, context: inspector_row_context, selected: true %>
    <% end %>
  <% else %>
    <%= turbo_stream.remove @task %>
  <% end %>
<% end %>

<% content_for :title, "Upload backup — Marskal" %>

<section class="page">
  <header class="page__header">
    <p class="page__crumb"><%= link_to "Import", import_batches_path %></p>
    <h1>OmniFocus backup</h1>
    <p class="page__lede">In OmniFocus: File → Export → Backup Document (.ofocus-backup). Todoist sign-in comes later.</p>
  </header>

  <%= form_with model: @batch, url: import_batches_path, class: "add-form" do |form| %>
    <div class="add-form__field">
      <%= form.label :payload, "Backup file" %>
      <%= form.file_field :payload, required: true, accept: ".ofocus-backup,.ofocus,.zip", class: "add-form__title" %>
    </div>
    <%= form.submit "Upload and preview", class: btn(:primary) %>
  <% end %>
</section>

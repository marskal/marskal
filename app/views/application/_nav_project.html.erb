<% current = current_page?(project_path(project)) %>
<li class="nav-tree__node nav-tree__node--project">
  <div class="nav-tree__row">
    <span class="nav-tree__toggle nav-tree__toggle--spacer" aria-hidden="true"></span>
    <%= link_to project_path(project),
          class: [ "nav-tree__link nav-tree__link--project", ("is-current" if current) ],
          aria: { current: (current ? "page" : nil) } do %>
      <%= icon "circle" %>
      <span class="nav-tree__label"><%= project.title %></span>
    <% end %>
  </div>
</li>

{
  "manifest_version": 3,
  "name": "Marskal",
  "description": "Add web pages as tasks to Marskal, an open-source, self-hosted personal task manager.",
  "version": "0.2.0",
  "author": "Mikkel T. Hoegh",
  "homepage_url": "https://github.com/marskal/marskal",
  "action": {
    "default_title": "Add to Marskal inbox",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": { "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png" },
  "permissions": ["activeTab", "scripting", "contextMenus", "notifications", "storage"],
  "optional_host_permissions": ["https://*/*"]
}

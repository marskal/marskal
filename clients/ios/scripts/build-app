#!/usr/bin/env bash
# Generates the Xcode project, builds the app for the simulator, and
# brings the String Catalog up to date with the strings in the source
# (ADR 0029). Xcode does the last step itself; xcodebuild does not.
#
# Run from the clients/ios devenv shell, after scripts/build-core.

set -euo pipefail

ios=$(cd "$(dirname "$0")/.." && pwd)
cd "$ios"

xcodegen generate --quiet

# Xcode with none of the Nix shell's compiler and linker settings.
xcode() { /usr/bin/env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin "$@"; }

xcode xcodebuild build \
  -project Marskal.xcodeproj -scheme Marskal \
  -destination "generic/platform=iOS Simulator" \
  -derivedDataPath build/derived -quiet

# Each target's catalog takes its own strings and MarskalKit's, such as
# the App Intents' titles, which are looked up in the running target.
# Xcode does not extract a package's strings, so they are read from the
# source. MarskalKit writes them out in full: LocalizedStringResource("…").
kit=build/kit-strings
rm -rf "$kit"
mkdir -p "$kit"
xcode xcrun xcstringstool extract --modern-localizable-strings \
  MarskalKit/Sources/MarskalKit/*.swift --output-directory "$kit"

intermediates=build/derived/Build/Intermediates.noindex
for target in Marskal MarskalWidget; do
  objects=$intermediates/Marskal.build/Debug-iphonesimulator/$target.build/Objects-normal/arm64
  xcode xcrun xcstringstool sync \
    "$target/Localizable.xcstrings" --stringsdata "$objects"/*.stringsdata "$kit"/*.stringsdata
done

echo "Built Marskal.app for the simulator"

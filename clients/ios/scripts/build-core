#!/usr/bin/env bash
# Builds core/ffi for the iOS app (ADR 0029): a static library for devices
# and one for the Apple silicon simulator, wrapped in
# MarskalKit/Frameworks/MarskalCoreFFI.xcframework, and the Swift bindings
# in MarskalKit/Sources/MarskalCore. Both are build products, not committed.
#
# Run from the clients/ios devenv shell: `build-core`, or `build-core debug`.

set -euo pipefail

ios=$(cd "$(dirname "$0")/.." && pwd)
manifest=$ios/../../core/ffi/Cargo.toml
kit=$ios/MarskalKit
profile=${1:-release}

case $profile in
  release) cargo_profile=(--release) ;;
  debug) cargo_profile=() ;;
  *) echo "usage: build-core [release|debug]" >&2; exit 64 ;;
esac

# Its own target directory: this shell's Rust is not core/ffi's.
export CARGO_TARGET_DIR=$ios/build/cargo
export IPHONEOS_DEPLOYMENT_TARGET=27.0

# The C in the bundled SQLite compiles with Xcode's clang for the iOS SDKs,
# not with the Nix wrapper and SDK the shell puts first.
export DEVELOPER_DIR=$(/usr/bin/env -u DEVELOPER_DIR /usr/bin/xcode-select -p)
xcrun() { /usr/bin/env -u SDKROOT DEVELOPER_DIR="$DEVELOPER_DIR" /usr/bin/xcrun "$@"; }

build() {
  local target=$1 sdk=$2
  local var=${target//-/_}
  local sysroot
  sysroot=$(xcrun --sdk "$sdk" --show-sdk-path)

  env -u SDKROOT \
    "CC_$var=$(xcrun --sdk "$sdk" -f clang)" \
    "AR_$var=$(xcrun --sdk "$sdk" -f ar)" \
    "CFLAGS_$var=-isysroot $sysroot" \
    cargo rustc --quiet --manifest-path "$manifest" --lib --crate-type staticlib \
      "${cargo_profile[@]}" --target "$target"
}

build aarch64-apple-ios iphoneos
build aarch64-apple-ios-sim iphonesimulator

# The bindings come from the host library's metadata.
cargo build --quiet --manifest-path "$manifest" --lib "${cargo_profile[@]}"
generated=$ios/build/swift
rm -rf "$generated"
(cd "$(dirname "$manifest")" && cargo run --quiet --bin uniffi-bindgen -- \
  generate --library "$CARGO_TARGET_DIR/$profile/libmarskal_ffi.dylib" \
  --language swift --out-dir "$generated")

headers=$ios/build/headers
rm -rf "$headers"
mkdir -p "$headers"
cp "$generated/MarskalCoreFFI.h" "$headers/"
cp "$generated/MarskalCoreFFI.modulemap" "$headers/module.modulemap"

framework=$kit/Frameworks/MarskalCoreFFI.xcframework
rm -rf "$framework"
mkdir -p "$kit/Frameworks" "$kit/Sources/MarskalCore"
/usr/bin/env -u SDKROOT DEVELOPER_DIR="$DEVELOPER_DIR" /usr/bin/xcodebuild -create-xcframework \
  -library "$CARGO_TARGET_DIR/aarch64-apple-ios/$profile/libmarskal_ffi.a" -headers "$headers" \
  -library "$CARGO_TARGET_DIR/aarch64-apple-ios-sim/$profile/libmarskal_ffi.a" -headers "$headers" \
  -output "$framework" >/dev/null

cp "$generated/MarskalCore.swift" "$kit/Sources/MarskalCore/MarskalCore.swift"

echo "Built $framework ($profile)"

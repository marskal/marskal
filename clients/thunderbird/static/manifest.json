{
  "manifest_version": 3,
  "name": "Marskal",
  "description": "Add mail to your Marskal inbox as tasks.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird@marskal",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "message_display_action": {
    "default_title": "Add to Marskal inbox",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "64": "icon.svg"
  },
  "permissions": ["messagesRead", "menus", "storage", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}

{
  "manifest_version": 3,
  "name": "Marskal",
  "description": "Add mail as tasks to Marskal, an open-source, self-hosted personal task manager.",
  "version": "0.1.0",
  "author": "Mikkel T. Hoegh",
  "homepage_url": "https://github.com/marskal/marskal",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird@marskal.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "message_display_action": {
    "default_title": "Add to Marskal inbox",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "64": "logo.svg"
  },
  "permissions": ["messagesRead", "menus", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*"]
}

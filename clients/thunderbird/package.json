{
  "name": "marskal-thunderbird",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "check": "tsc",
    "test": "node --test 'test/*.test.ts'",
    "package": "node build.ts && rm -f marskal-thunderbird.xpi && cd dist && zip -qr ../marskal-thunderbird.xpi .",
    "source": "rm -f marskal-thunderbird-source.zip && git -C ../.. archive --format=zip -o \"$PWD/marskal-thunderbird-source.zip\" HEAD:clients/thunderbird ':!test' ':!devenv.*' ':!.gitignore'"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.61.0",
    "typescript": "^7.0.2"
  }
}

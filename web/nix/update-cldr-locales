#!/usr/bin/env bash
# Writes nix/cldr-locales.nix: a hash for each locale file Marskal.Cldr
# names, at the ex_cldr version in mix.lock (ADR 0027). Run it from web/ in
# the devenv shell after changing the locales or upgrading ex_cldr.
set -euo pipefail

version=$(sed -n 's/.*"ex_cldr": {:hex, :ex_cldr, "\([^"]*\)".*/\1/p' mix.lock)
# en ships in the ex_cldr package; the build downloads the rest.
locales=$(mix run --no-start -e '
  Marskal.Cldr.known_locale_names() |> Enum.map(&to_string/1) |> Enum.reject(&(&1 == "en"))
  |> Enum.sort() |> Enum.each(&IO.puts/1)')

{
  echo "# Generated by nix/update-cldr-locales for ex_cldr $version. Do not edit."
  echo "{"
  for locale in $locales; do
    url="https://raw.githubusercontent.com/elixir-cldr/cldr/v$version/priv/cldr/locales/$locale.json"
    hash=$(nix store prefetch-file --json "$url" | sed -n 's/.*"hash":"\([^"]*\)".*/\1/p')
    echo "  \"$locale\" = \"$hash\";"
  done
  echo "}"
} > nix/cldr-locales.nix.tmp

mv nix/cldr-locales.nix.tmp nix/cldr-locales.nix

// Type checking only: esbuild compiles, `npm run typecheck` checks.
//
// Hex packages are not npm dependencies. esbuild finds them through
// NODE_PATH (config/config.exs), and `paths` points TypeScript at the same
// place. Phoenix ships no types, so @types/phoenix stands in for it.
//
// Colocated hooks written with extension="ts" are extracted under _build,
// so they are checked there.
{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "phoenix_live_view": ["../deps/phoenix_live_view"]
    },
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*", "../_build/*/phoenix-colocated/marskal/**/*.ts"]
}

<% children = tree.child_folders(folder) %>
<% projects = tree.projects_in(folder) %>
<% expandable = tree.expandable?(folder) %>
<% current = current_page?(project_folder_path(folder)) %>
<li class="nav-tree__node nav-tree__node--folder"
    data-sidebar-folder-id="<%= folder.id %>"
    data-expanded="true">
  <div class="nav-tree__row">
    <% if expandable %>
      <button type="button"
              class="nav-tree__toggle"
              data-action="sidebar#toggleFolder"
              aria-expanded="true"
              aria-label="Toggle <%= folder.name %>">
        <%= icon "chevron-right" %>
      </button>
    <% else %>
      <span class="nav-tree__toggle nav-tree__toggle--spacer" aria-hidden="true"></span>
    <% end %>
    <%= link_to project_folder_path(folder),
          class: [ "nav-tree__link nav-tree__link--folder", ("is-current" if current) ],
          aria: { current: (current ? "page" : nil) } do %>
      <%= icon "folder" %>
      <span class="nav-tree__label"><%= folder.name %></span>
    <% end %>
  </div>
  <% if expandable %>
    <ul class="nav-tree">
      <% children.each do |child| %>
        <%= render "application/nav_folder", folder: child, tree: tree %>
      <% end %>
      <% projects.each do |project| %>
        <%= render "application/nav_project", project: project %>
      <% end %>
    </ul>
  <% end %>
</li>

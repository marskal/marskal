<% content_for :title, "Open tasks — Marskal" %>

<section class="page">
  <header class="page__header">
    <h1>Open tasks</h1>
    <p class="page__lede">Work that’s out of the inbox and still to-do.</p>
  </header>

  <%= render "tasks/add_form" %>

  <% if @tasks.any? %>
    <%= render "tasks/list", tasks: @tasks, context: :open %>
  <% else %>
    <%= render EmptyStateComponent.new do %>
      No open tasks. Add something in <%= link_to "Inbox", inbox_path %>, then move it here.
    <% end %>
  <% end %>
</section>

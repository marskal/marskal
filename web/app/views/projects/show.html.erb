<% content_for :title, "#{@project.title} — Marskal" %>

<section class="page">
  <header class="page__header">
    <p class="page__crumb">
      <%= link_to "Projects", projects_path %>
      <% if @project.project_folder %>
        <span class="page__crumb-sep">/</span>
        <%= link_to @project.project_folder.breadcrumb_label, project_folder_path(@project.project_folder) %>
      <% end %>
    </p>
    <h1 data-inspect-type="project" data-inspect-id="<%= @project.id %>">
      <%= link_to @project, class: "page__inspect select", data: inspect_link_data(@project) do %>
        <span id="page-heading"><%= @project.title %></span>
      <% end %>
    </h1>
    <% if @project.notes.present? %>
      <div class="page__lede project-notes"><%= formatted_notes(@project.notes) %></div>
    <% end %>

    <%= form_with model: @project, class: "folder-assign" do |form| %>
      <%= form.label :project_folder_id, "Folder" %>
      <%= form.select :project_folder_id,
            options_for_select([["Unfiled", ""]] + @folder_options, @project.project_folder_id),
            {},
            class: "add-form__select",
            onchange: "this.form.requestSubmit()" %>
    <% end %>

    <div class="page__actions">
      <% if @project.to_do? %>
        <%= button_to "Done", complete_project_path(@project), method: :patch, class: btn %>
        <%= button_to "Drop", drop_project_path(@project), method: :patch, class: btn(:ghost) %>
      <% else %>
        <span class="page__state"><%= @project.state.humanize %></span>
        <%= button_to "Reopen", reopen_project_path(@project), method: :patch, class: btn(:ghost) %>
      <% end %>
    </div>
  </header>

  <h2 class="section-heading">Open tasks</h2>

  <%= form_with model: @task, url: tasks_path, class: "add-form" do |form| %>
    <%= form.hidden_field :project_id, value: @project.id %>
    <div class="add-form__row">
      <%= form.text_field :title,
            required: true,
            autofocus: true,
            placeholder: "Add a task to this project…",
            class: "add-form__title",
            autocomplete: "off" %>
      <%= form.submit "Add", class: btn(:primary) %>
    </div>
    <details class="add-form__notes">
      <summary>Notes (optional)</summary>
      <%= form.text_area :notes, rows: 3, placeholder: "Markdown is fine…", class: "add-form__notes-field" %>
    </details>
  <% end %>

  <% if @tasks.any? %>
    <%= render "tasks/list", tasks: @tasks, context: :project %>
  <% else %>
    <%= render EmptyStateComponent.new do %>
      No open tasks in this project yet.
    <% end %>
  <% end %>
</section>

<% content_for :title, "Import — Marskal" %>
<% if @batch.pending? || @batch.applying? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="2">
  <% end %>
<% end %>

<section class="page">
  <header class="page__header">
    <p class="page__crumb"><%= link_to "Import", import_batches_path %></p>
    <h1><%= @batch.source.humanize %> import</h1>
    <p class="page__lede"><%= @batch.filename.presence || "Backup" %> · <%= @batch.status.humanize %></p>
  </header>

  <% if @batch.failed? %>
    <p class="flash flash--alert" role="alert"><%= @batch.error_message %></p>
    <p><%= link_to "Try another file", new_import_batch_path, class: btn %></p>
  <% elsif @batch.pending? %>
    <p class="empty-state">Reading the backup…</p>
  <% elsif @batch.applying? %>
    <p class="empty-state">Writing folders, projects, and tasks…</p>
  <% elsif @batch.previewed? %>
    <dl class="import-stats">
      <div><dt>Folders</dt><dd><%= @batch.stats["folders"] %></dd></div>
      <div><dt>Projects</dt><dd><%= @batch.stats["projects"] %></dd></div>
      <div><dt>Tasks</dt><dd><%= @batch.stats["tasks"] %></dd></div>
      <div><dt>Inbox</dt><dd><%= @batch.stats["inbox"] %></dd></div>
    </dl>
    <% if @batch.stats["samples"].present? %>
      <p class="page__lede">Includes: <%= Array(@batch.stats["samples"]).join(", ") %></p>
    <% end %>
    <p class="page__lede">Already-imported OmniFocus items are skipped. Dates and tags are stored for later; they are not applied yet.</p>
    <%= button_to "Import into Marskal", apply_import_batch_path(@batch), method: :post, class: btn(:primary) %>
  <% elsif @batch.applied? %>
    <dl class="import-stats">
      <div><dt>Created folders</dt><dd><%= @batch.stats.dig("created", "folders") %></dd></div>
      <div><dt>Created projects</dt><dd><%= @batch.stats.dig("created", "projects") %></dd></div>
      <div><dt>Created tasks</dt><dd><%= @batch.stats.dig("created", "tasks") %></dd></div>
      <div><dt>Skipped</dt><dd><%= @batch.stats.dig("skipped")&.values&.sum %></dd></div>
    </dl>
    <div class="page__actions">
      <%= link_to "Inbox", inbox_path, class: btn(:primary) %>
      <%= link_to "Projects", projects_path, class: btn %>
    </div>
  <% end %>
</section>
